# ContextSurgeon Environment Configuration
# Copy this to .env and customize for your setup
#
# Mock mode (no API key needed) works out of the box for demos.
# Set OPENAI_API_KEY to use real API for actual ablation testing.

# OpenAI API Configuration
# OPENAI_API_KEY=sk-...                  # Uncomment and set to use real API
OPENAI_MODEL=gpt-4                       # Model to use (gpt-4, gpt-3.5-turbo, etc)
OPENAI_TEMPERATURE=0.3                   # Lower = more deterministic (0.0-1.0)
OPENAI_RETRIES=3                         # Retry attempts on API failure
OPENAI_TIMEOUT=30                        # Request timeout in seconds

# Caching Configuration
CACHE_ENABLED=true                       # Enable/disable caching
CACHE_DIR=.context-surgeon               # Where to store cache and trends

# Debug Mode
DEBUG=false                              # Enable verbose logging
